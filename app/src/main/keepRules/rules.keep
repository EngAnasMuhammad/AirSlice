# Keep Hilt & Dagger Generated Classes & Annotations
-keep class com.anasdev.fluxlink.** { *; }
-keepclassmembers class * {
    @javax.inject.Inject <init>(...);
    @dagger.Provides <init>(...);
}
-keep class * extends androidx.lifecycle.ViewModel { *; }
-keep class dagger.hilt.** { *; }
-keep class androidx.hilt.** { *; }

# Keep Domain Models & Data Classes
-keep class com.anasdev.fluxlink.domain.model.** { *; }
-keep class com.anasdev.fluxlink.data.** { *; }

# Keep Android Foreground Services & Receivers
-keep class com.anasdev.fluxlink.service.ServerForegroundService { *; }
