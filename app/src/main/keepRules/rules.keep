# NEVER obfuscate class/method/field names (prevents reflection & Ktor crashes)
-dontobfuscate
-dontoptimize

# Keep 100% of our app's own classes, fields, and methods untouched
-keep class com.anasdev.fluxlink.** { *; }
-keep class nasdev.fluxlink.** { *; }

# Keep 100% of Ktor, Coroutines, Kotlinx Serialization, and Hilt
-keep class io.ktor.** { *; }
-keep class kotlinx.coroutines.** { *; }
-keep class kotlinx.serialization.** { *; }
-keep class dagger.hilt.** { *; }
-keep class javax.inject.** { *; }
-keepattributes *Annotation*, Signature, InnerClasses, EnclosingMethod

-dontwarn io.ktor.**
-dontwarn kotlinx.**
-dontwarn org.slf4j.**
-dontwarn java.lang.instrument.**
-dontwarn com.google.zxing.**
